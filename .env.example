# Copy to .env and fill in. .env is git-ignored.

# Needed for recording and replay. The offline checks in tests/ do not read .env.
OPENAI_API_KEY=

# Kitaru server. Leave blank for the offline checks; `kitaru login` can also
# store these for you.
KITARU_API_URL=
KITARU_API_KEY=

# Small, cheap model on purpose: small models break the rules more often.
# The README baseline was recorded with gpt-4o-mini; v6 used gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-nano

# Which prompt file in prompts/ to load, without the .md extension.
REFUND_PROMPT=refund_v1

# Filled in after `kitaru agent register` (see Quick start in README.md).
SUPPORT_DESK_AGENT_ID=
SUPPORT_DESK_AGENT_VERSION_ID=
